{
  "name": "@vctrust/wallet-app",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "gen:config": "node scripts/gen-wallet-provider.mjs",
    "start": "npm run gen:config && expo start",
    "web": "npm run gen:config && expo start --web",
    "android": "npm run gen:config && expo start --android",
    "ios": "npm run gen:config && expo start --ios",
    "export:web": "npm run gen:config && expo export --platform web --output-dir dist",
    "export:android": "npm run gen:config && expo export --platform android --output-dir dist-android",
    "typecheck": "npm run gen:config && tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@vctrust/trust-client": "0.1.0",
    "@vctrust/wallet-core": "0.1.0",
    "expo": "~58.0.22",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
