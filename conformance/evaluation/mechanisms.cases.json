  "mechanisms": [
    {
      "id": "national-id",
      "for": {
        "role": "issuer",
        "formats": [
          "mso_mdoc"
        ],
        "types": [
          "org.example.id.*"
        ]
      },
      "keys": [
        "x5c"
      ],
      "x509": {
        "domain": "national-id",
        "profile": {
          "leaf": {
            "ca": false,
            "key-usage": [
              "digitalSignature"
            ],
            "extended-key-usage": [
              "1.3.6.1.4.1.99999.1.1"
            ],
            "same-country-as-anchor": true,
            "max-validity-days": 7100,
            "crl-distribution-point": true
          },
          "max-intermediates": 0
        },
        "revocation": "required"
      }
    },
    {
      "id": "mdl",
